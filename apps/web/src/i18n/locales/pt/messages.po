msgstr "Criar conta"

msgid "Sign out"
msgstr "Sair"

msgid "Create an account"
msgstr "Criar uma conta"

msgid "Welcome back"
msgstr "Bem-vindo de volta"

msgid "Display name"
msgstr "Nome de exibição"

msgid "Email"
msgstr "Email"

msgid "Password"
msgstr "Senha"

