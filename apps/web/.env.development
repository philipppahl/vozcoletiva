VITE_USE_MOCKS=1

# These three are bypassed by MSW handlers but the env loader insists on
# something. Use the dev pool's values so nothing crashes if a real Cognito
# call ever leaks through.
VITE_API_BASE_URL=https://mock.local/v1
VITE_USER_POOL_ID=mock_pool
VITE_USER_POOL_CLIENT_ID=mock_client
VITE_AWS_REGION=eu-west-1
