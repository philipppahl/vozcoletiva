{
  "name": "vozcoletiva",
  "private": true,
  "version": "0.0.0",
  "description": "Mobile-first PWA for structured collective decision-making.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/infra",
    "packages/api-client",
    "packages/shared"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "api:generate": "bun packages/api-client/scripts/generate.ts",
    "api:verify": "bun packages/api-client/scripts/generate.ts --verify",
    "deploy": "bun apps/infra/scripts/deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
